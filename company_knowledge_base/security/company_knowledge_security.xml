    <!-- Article visibility: internal articles or articles allowed by current user's groups.
         The category visibility is also enforced. -->
    <record id="rule_company_knowledge_article_reader_visible" model="ir.rule">
        <field name="name">KB Article - lettura articoli visibili</field>
        <field name="model_id" ref="model_company_knowledge_article"/>
        <field name="groups" eval="[(4, ref('group_company_knowledge_user'))]"/>
        <field name="domain_force">['&amp;', '|', '|', '|', '|', ('visibility', '=', 'internal'), ('visibility', '=', 'portal'), ('allowed_group_ids', 'in', user.groups_id.ids), ('allowed_user_ids', 'in', [user.id]), ('allowed_area_ids.user_ids', 'in', [user.id]), '|', '|', ('category_id.visibility', '=', 'internal'), ('category_id.allowed_group_ids', 'in', user.groups_id.ids), ('category_id.allowed_area_ids.user_ids', 'in', [user.id])]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_company_knowledge_article_editor_write_own" model="ir.rule">
        <field name="name">KB Article - editor modifica propri articoli non pubblicati</field>
        <field name="model_id" ref="model_company_knowledge_article"/>
        <field name="groups" eval="[(4, ref('group_company_knowledge_editor'))]"/>
        <field name="domain_force">[('author_id', '=', user.id), ('state', 'in', ['draft', 'changes_requested', 'review'])]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

