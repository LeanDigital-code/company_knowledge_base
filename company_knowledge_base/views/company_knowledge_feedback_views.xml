<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_knowledge_feedback_list" model="ir.ui.view">
        <field name="name">company.knowledge.feedback.list</field>
        <field name="model">company.knowledge.feedback</field>
        <field name="arch" type="xml">
            <list string="Feedback Knowledge Base"
                  decoration-danger="severity == 'critical' and state == 'todo'"
                  decoration-warning="severity == 'high' and state == 'todo'"
                  decoration-muted="state in ['done', 'rejected']">
                <field name="create_date" string="Data"/>
                <field name="article_id"/>
                <field name="user_id"/>
                <field name="feedback_type"/>
                <field name="severity" widget="badge" decoration-danger="severity == 'critical'" decoration-warning="severity == 'high'" decoration-info="severity == 'medium'" decoration-muted="severity == 'low'"/>
                <field name="rating"/>
                <field name="assigned_user_id"/>
                <field name="due_date"/>
                <field name="activity_id" optional="hide"/>
                <field name="resolved_by_id" optional="hide"/>
                <field name="resolved_date" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-danger="state == 'todo'" decoration-muted="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_company_knowledge_feedback_form" model="ir.ui.view">
        <field name="name">company.knowledge.feedback.form</field>
        <field name="model">company.knowledge.feedback</field>
        <field name="arch" type="xml">
            <form string="Feedback articolo">
                <header>
                    <button name="action_open_article" type="object" string="Apri articolo" icon="fa-book"/>
                    <button name="action_create_activity" type="object" string="Crea attività" icon="fa-clock-o" invisible="state != 'todo' or activity_id" groups="company_knowledge_base.group_company_knowledge_editor"/>
                    <button name="action_mark_done" type="object" string="Segna risolto" class="oe_highlight" invisible="state != 'todo'" groups="company_knowledge_base.group_company_knowledge_editor"/>
                    <button name="action_reject" type="object" string="Scarta" invisible="state != 'todo'" groups="company_knowledge_base.group_company_knowledge_editor"/>
                    <button name="action_reset_todo" type="object" string="Riapri" invisible="state == 'todo'" groups="company_knowledge_base.group_company_knowledge_editor"/>
                    <field name="state" widget="statusbar" statusbar_visible="todo,done,rejected"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="article_id"/>
                            <field name="user_id" readonly="1"/>
                            <field name="assigned_user_id" readonly="1"/>
                            <field name="due_date"/>
                            <field name="activity_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="feedback_type"/>
                            <field name="severity" widget="radio"/>
                            <field name="rating" widget="radio"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Commento">
                        <field name="comment" nolabel="1" placeholder="Scrivi il feedback, l’errore trovato o l’informazione mancante..."/>
                    </group>
                    <group string="Gestione" invisible="state == 'todo' and not resolution_note">
                        <group>
                            <field name="resolved_by_id" readonly="1"/>
                            <field name="resolved_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="resolution_note" placeholder="Descrivi come è stato gestito il feedback..."/>
                        </group>
                    </group>
                </sheet>
                <chatter>
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </chatter>
            </form>
        </field>
    </record>

    <record id="view_company_knowledge_feedback_search" model="ir.ui.view">
        <field name="name">company.knowledge.feedback.search</field>
        <field name="model">company.knowledge.feedback</field>
        <field name="arch" type="xml">
            <search string="Cerca feedback">
                <field name="article_id"/>
                <field name="user_id"/>
                <field name="assigned_user_id"/>
                <field name="feedback_type"/>
                <field name="severity"/>
                <field name="comment"/>
                <filter string="Da gestire" name="todo" domain="[('state', '=', 'todo')]"/>
                <filter string="Alta/Critica" name="high_critical" domain="[('severity', 'in', ['high', 'critical']), ('state', '=', 'todo')]"/>
                <filter string="Errori/Obsoleti/Mancanti" name="critical" domain="[('feedback_type', 'in', ['error', 'obsolete', 'missing']), ('state', '=', 'todo')]"/>
                <filter string="Scaduti" name="overdue" domain="[('due_date', '&lt;', context_today().strftime('%Y-%m-%d')), ('state', '=', 'todo')]"/>
                <filter string="Senza attività" name="without_activity" domain="[('activity_id', '=', False), ('state', '=', 'todo'), ('feedback_type', 'in', ['not_useful', 'error', 'obsolete', 'missing'])]"/>
                <filter string="Miei feedback" name="my_feedback" domain="[('user_id', '=', uid)]"/>
                <filter string="Assegnati a me" name="assigned_to_me" domain="[('assigned_user_id', '=', uid), ('state', '=', 'todo')]"/>
                <group expand="0" string="Raggruppa per">
                    <filter string="Articolo" name="group_article" context="{'group_by': 'article_id'}"/>
                    <filter string="Responsabile" name="group_assigned" context="{'group_by': 'assigned_user_id'}"/>
                    <filter string="Tipo" name="group_type" context="{'group_by': 'feedback_type'}"/>
                    <filter string="Severità" name="group_severity" context="{'group_by': 'severity'}"/>
                    <filter string="Stato" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Scadenza" name="group_due_date" context="{'group_by': 'due_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_company_knowledge_feedback" model="ir.actions.act_window">
        <field name="name">Feedback</field>
        <field name="res_model">company.knowledge.feedback</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_company_knowledge_feedback_search"/>
        <field name="context">{'search_default_todo': 1}</field>
    </record>

    <record id="action_company_knowledge_feedback_critical" model="ir.actions.act_window">
        <field name="name">Feedback critici</field>
        <field name="res_model">company.knowledge.feedback</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_company_knowledge_feedback_search"/>
        <field name="domain">[('state', '=', 'todo'), '|', ('severity', 'in', ['high', 'critical']), ('feedback_type', 'in', ['error', 'obsolete', 'missing'])]</field>
        <field name="context">{'search_default_high_critical': 1}</field>
    </record>
</odoo>
