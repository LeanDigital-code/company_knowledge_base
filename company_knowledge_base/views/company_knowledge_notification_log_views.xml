<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_knowledge_notification_log_list" model="ir.ui.view">
        <field name="name">company.knowledge.notification.log.list</field>
        <field name="model">company.knowledge.notification.log</field>
        <field name="arch" type="xml">
            <list string="Notifiche Knowledge Base">
                <field name="sent_on"/>
                <field name="article_id"/>
                <field name="notification_type" widget="badge"/>
                <field name="user_id"/>
                <field name="sent_by_id"/>
                <field name="activity_created"/>
                <field name="activity_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_company_knowledge_notification_log_form" model="ir.ui.view">
        <field name="name">company.knowledge.notification.log.form</field>
        <field name="model">company.knowledge.notification.log</field>
        <field name="arch" type="xml">
            <form string="Notifica Knowledge Base">
                <header>
                    <button name="action_open_article" type="object" string="Apri articolo" icon="fa-external-link"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="article_id" readonly="1"/>
                            <field name="notification_type" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="sent_by_id" readonly="1"/>
                            <field name="sent_on" readonly="1"/>
                            <field name="activity_created" readonly="1"/>
                            <field name="activity_id" readonly="1" invisible="not activity_created"/>
                        </group>
                    </group>
                    <group string="Messaggio">
                        <field name="message" readonly="1" widget="html"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_company_knowledge_notification_log_search" model="ir.ui.view">
        <field name="name">company.knowledge.notification.log.search</field>
        <field name="model">company.knowledge.notification.log</field>
        <field name="arch" type="xml">
            <search string="Cerca notifiche">
                <field name="article_id"/>
                <field name="user_id"/>
                <field name="sent_by_id"/>
                <field name="notification_type"/>
                <filter string="Pubblicazioni" name="publish" domain="[('notification_type', '=', 'publish')]"/>
                <filter string="Aggiornamenti" name="updates" domain="[('notification_type', '=', 'update')]"/>
                <filter string="Con attività" name="with_activity" domain="[('activity_created', '=', True)]"/>
                <group expand="0" string="Raggruppa per">
                    <filter string="Articolo" name="group_article" context="{'group_by': 'article_id'}"/>
                    <filter string="Destinatario" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Tipo" name="group_type" context="{'group_by': 'notification_type'}"/>
                    <filter string="Mese invio" name="group_month" context="{'group_by': 'sent_on:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_company_knowledge_notification_log_pivot" model="ir.ui.view">
        <field name="name">company.knowledge.notification.log.pivot</field>
        <field name="model">company.knowledge.notification.log</field>
        <field name="arch" type="xml">
            <pivot string="Analisi notifiche">
                <field name="notification_type" type="row"/>
                <field name="sent_on" interval="month" type="col"/>
                <field name="user_id" type="row"/>
            </pivot>
        </field>
    </record>

    <record id="view_company_knowledge_notification_log_graph" model="ir.ui.view">
        <field name="name">company.knowledge.notification.log.graph</field>
        <field name="model">company.knowledge.notification.log</field>
        <field name="arch" type="xml">
            <graph string="Notifiche inviate" type="bar">
                <field name="notification_type"/>
            </graph>
        </field>
    </record>

    <record id="action_company_knowledge_notification_log" model="ir.actions.act_window">
        <field name="name">Notifiche inviate</field>
        <field name="res_model">company.knowledge.notification.log</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_company_knowledge_notification_log_search"/>
    </record>
</odoo>
