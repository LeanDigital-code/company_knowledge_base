<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_knowledge_acknowledgement_list" model="ir.ui.view">
        <field name="name">company.knowledge.acknowledgement.list</field>
        <field name="model">company.knowledge.acknowledgement</field>
        <field name="arch" type="xml">
            <list string="Conferme lettura" create="0" edit="0" delete="0">
                <field name="acknowledged_on"/>
                <field name="article_id"/>
                <field name="user_id"/>
                <field name="note" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_company_knowledge_acknowledgement_form" model="ir.ui.view">
        <field name="name">company.knowledge.acknowledgement.form</field>
        <field name="model">company.knowledge.acknowledgement</field>
        <field name="arch" type="xml">
            <form string="Conferma lettura" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="article_id"/>
                        <field name="user_id"/>
                        <field name="acknowledged_on"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_company_knowledge_acknowledgement_search" model="ir.ui.view">
        <field name="name">company.knowledge.acknowledgement.search</field>
        <field name="model">company.knowledge.acknowledgement</field>
        <field name="arch" type="xml">
            <search string="Cerca conferme lettura">
                <field name="article_id"/>
                <field name="user_id"/>
                <filter string="Le mie conferme" name="my_acknowledgements" domain="[('user_id', '=', uid)]"/>
                <group expand="0" string="Raggruppa per">
                    <filter string="Articolo" name="group_article" context="{'group_by': 'article_id'}"/>
                    <filter string="Utente" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Mese" name="group_month" context="{'group_by': 'acknowledged_on:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_company_knowledge_acknowledgement" model="ir.actions.act_window">
        <field name="name">Conferme lettura</field>
        <field name="res_model">company.knowledge.acknowledgement</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_company_knowledge_acknowledgement_search"/>
        <field name="context">{'search_default_group_article': 1}</field>
    </record>
</odoo>
