<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_knowledge_favorite_list" model="ir.ui.view">
        <field name="name">company.knowledge.favorite.list</field>
        <field name="model">company.knowledge.favorite</field>
        <field name="arch" type="xml">
            <list string="Preferiti Knowledge Base" create="false" edit="false">
                <field name="create_date" string="Aggiunto il"/>
                <field name="article_id"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="view_company_knowledge_favorite_form" model="ir.ui.view">
        <field name="name">company.knowledge.favorite.form</field>
        <field name="model">company.knowledge.favorite</field>
        <field name="arch" type="xml">
            <form string="Preferito Knowledge Base">
                <sheet>
                    <group>
                        <field name="article_id"/>
                        <field name="user_id" readonly="1"/>
                        <field name="create_date" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_company_knowledge_favorite_search" model="ir.ui.view">
        <field name="name">company.knowledge.favorite.search</field>
        <field name="model">company.knowledge.favorite</field>
        <field name="arch" type="xml">
            <search string="Cerca preferiti">
                <field name="article_id"/>
                <field name="user_id"/>
                <filter string="I miei preferiti" name="my_favorites" domain="[('user_id', '=', uid)]"/>
                <group expand="0" string="Raggruppa per">
                    <filter string="Utente" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Articolo" name="group_article" context="{'group_by': 'article_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_company_knowledge_favorite" model="ir.actions.act_window">
        <field name="name">Preferiti</field>
        <field name="res_model">company.knowledge.favorite</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_company_knowledge_favorite_search"/>
        <field name="context">{'search_default_my_favorites': 1}</field>
    </record>
</odoo>
