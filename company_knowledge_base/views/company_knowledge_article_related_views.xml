<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_knowledge_article_related_list" model="ir.ui.view">
        <field name="name">company.knowledge.article.related.list</field>
        <field name="model">company.knowledge.article.related</field>
        <field name="arch" type="xml">
            <list string="Record collegati Knowledge Base">
                <field name="article_id"/>
                <field name="model_id"/>
                <field name="res_id"/>
                <field name="note" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_company_knowledge_article_related_form" model="ir.ui.view">
        <field name="name">company.knowledge.article.related.form</field>
        <field name="model">company.knowledge.article.related</field>
        <field name="arch" type="xml">
            <form string="Record collegato">
                <header>
                    <button name="action_open_record" type="object" string="Apri record" class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="article_id"/>
                            <field name="model_id" options="{'no_create_edit': True}"/>
                            <field name="res_model" readonly="1"/>
                        </group>
                        <group>
                            <field name="res_id"/>
                            <field name="record_display_name" readonly="1"/>
                            <field name="note"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_company_knowledge_article_related_search" model="ir.ui.view">
        <field name="name">company.knowledge.article.related.search</field>
        <field name="model">company.knowledge.article.related</field>
        <field name="arch" type="xml">
            <search string="Cerca collegamenti">
                <field name="article_id"/>
                <field name="model_id"/>
                <field name="res_model"/>
                <field name="res_id"/>
                <group expand="0" string="Raggruppa per">
                    <filter string="Articolo" name="group_article" context="{'group_by': 'article_id'}"/>
                    <filter string="Modello" name="group_model" context="{'group_by': 'model_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_company_knowledge_article_related" model="ir.actions.act_window">
        <field name="name">Record collegati</field>
        <field name="res_model">company.knowledge.article.related</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_company_knowledge_article_related_search"/>
    </record>
</odoo>
