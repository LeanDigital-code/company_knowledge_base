<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_knowledge_import_wizard_form" model="ir.ui.view">
        <field name="name">company.knowledge.import.wizard.form</field>
        <field name="model">company.knowledge.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importa articoli Knowledge Base">
                <sheet>
                    <p class="text-muted">
                        Carica un CSV con intestazioni. Campi riconosciuti: title/titolo/name, summary/descrizione,
                        body_html/contenuto, category/categoria, tags, article_type/tipo, visibility, owner/responsabile,
                        area/reparto, review_date.
                    </p>
                    <group>
                        <group>
                            <field name="file_data" filename="file_name"/>
                            <field name="file_name" invisible="1"/>
                            <field name="delimiter"/>
                            <field name="create_missing_categories"/>
                        </group>
                        <group>
                            <field name="default_category_id"/>
                            <field name="default_owner_id"/>
                            <field name="default_area_id"/>
                        </group>
                    </group>
                    <group invisible="not result_html">
                        <field name="imported_count" readonly="1"/>
                        <field name="skipped_count" readonly="1"/>
                        <field name="result_html" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Importa" type="object" name="action_import" class="btn-primary"/>
                    <button string="Chiudi" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_company_knowledge_import_wizard" model="ir.actions.act_window">
        <field name="name">Importa articoli</field>
        <field name="res_model">company.knowledge.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
