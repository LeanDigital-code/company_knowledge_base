<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_knowledge_review_wizard_form" model="ir.ui.view">
        <field name="name">company.knowledge.review.wizard.form</field>
        <field name="model">company.knowledge.review.wizard</field>
        <field name="arch" type="xml">
            <form string="Richiedi modifiche">
                <sheet>
                    <group>
                        <field name="article_id"/>
                        <field name="action_type"/>
                    </group>
                    <group string="Motivazione obbligatoria">
                        <field name="note" nolabel="1" placeholder="Indica cosa deve essere corretto, integrato o chiarito..."/>
                    </group>
                </sheet>
                <footer>
                    <button string="Conferma" name="action_confirm" type="object" class="btn-primary"/>
                    <button string="Annulla" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
