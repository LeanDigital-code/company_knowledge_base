<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_knowledge_export_wizard_form" model="ir.ui.view">
        <field name="name">company.knowledge.export.wizard.form</field>
        <field name="model">company.knowledge.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Esporta articoli Knowledge Base">
                <sheet>
                    <group>
                        <field name="article_ids" widget="many2many_tags"/>
                        <field name="export_format"/>
                        <field name="include_body_text" invisible="export_format != 'csv'"/>
                    </group>
                    <group invisible="not file_data or export_format == 'pdf'">
                        <field name="file_name" readonly="1"/>
                        <field name="file_data" filename="file_name" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Genera file" type="object" name="action_generate_file" class="btn-primary"/>
                    <button string="Scarica" type="object" name="action_download_file" class="btn-secondary" invisible="not file_data or export_format == 'pdf'"/>
                    <button string="Chiudi" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_company_knowledge_export_wizard" model="ir.actions.act_window">
        <field name="name">Esporta articoli</field>
        <field name="res_model">company.knowledge.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="server_action_company_knowledge_export_articles" model="ir.actions.server">
        <field name="name">Esporta articoli Knowledge Base</field>
        <field name="model_id" ref="model_company_knowledge_article"/>
        <field name="binding_model_id" ref="model_company_knowledge_article"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_open_export_wizard()</field>
    </record>
</odoo>
