<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="area_general" model="company.knowledge.area">
        <field name="name">Generale</field>
        <field name="code">GEN</field>
        <field name="sequence">1</field>
        <field name="description">Area trasversale per contenuti aziendali generali.</field>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        <field name="manager_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="category_procedure" model="company.knowledge.category">
        <field name="name">Procedure operative</field>
        <field name="sequence">10</field>
        <field name="description">Procedure interne, istruzioni operative e flussi standard.</field>
    </record>
    <record id="category_faq" model="company.knowledge.category">
        <field name="name">FAQ</field>
        <field name="sequence">20</field>
        <field name="description">Domande frequenti e risposte operative.</field>
    </record>
    <record id="category_technical_guides" model="company.knowledge.category">
        <field name="name">Guide tecniche</field>
        <field name="sequence">30</field>
        <field name="description">Manuali tecnici, troubleshooting e documentazione IT.</field>
    </record>
    <record id="category_policy" model="company.knowledge.category">
        <field name="name">Policy aziendali</field>
        <field name="sequence">40</field>
        <field name="description">Regole, policy e linee guida aziendali.</field>
    </record>

    <record id="tag_processi" model="company.knowledge.tag">
        <field name="name">Processi</field>
        <field name="color">2</field>
    </record>
    <record id="tag_odoo" model="company.knowledge.tag">
        <field name="name">Odoo</field>
        <field name="color">4</field>
    </record>
    <record id="tag_magazzino" model="company.knowledge.tag">
        <field name="name">Magazzino</field>
        <field name="color">6</field>
    </record>
    <record id="tag_crm" model="company.knowledge.tag">
        <field name="name">CRM</field>
        <field name="color">8</field>
    </record>
    <record id="tag_it" model="company.knowledge.tag">
        <field name="name">IT</field>
        <field name="color">10</field>
    </record>
</odoo>
